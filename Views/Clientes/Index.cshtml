@model IEnumerable<BikeServicePro.ViewModels.Clientes.ClienteListViewModel>

@{
    ViewData["Title"] = "Clientes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nuevo Cliente
        </a>
    </div>
    <div>
        <form asp-action="Index" method="get" class="d-flex">
            <input type="text" name="searchTerm" class="form-control me-2" placeholder="Buscar cliente..." value="@ViewData["SearchTerm"]" />
            <button type="submit" class="btn btn-outline-secondary">
                <i class="bi bi-search"></i>
            </button>
        </form>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Email</th>
                <th>Teléfono</th>
                <th>Fecha Registro</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                @foreach (var cliente in Model)
                {
                    <tr>
                        <td>@cliente.NombreCompleto</td>
                        <td>@cliente.Email</td>
                        <td>@cliente.Telefono</td>
                        <td>@cliente.FechaRegistro.ToString("dd/MM/yyyy")</td>
                        <td>
                            <span class="badge @(cliente.Activo ? "bg-success" : "bg-danger")">
                                @(cliente.Activo ? "Activo" : "Inactivo")
                            </span>
                        </td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Details" asp-route-id="@cliente.Id" class="btn btn-info">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@cliente.Id" class="btn btn-warning">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@cliente.Id" method="post" style="display:inline;" onsubmit="return confirm('¿Estás seguro de eliminar este cliente?');">
                                    <button type="submit" class="btn btn-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">
                        <i class="bi bi-inbox fs-3 d-block"></i>
                        No hay clientes registrados
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>