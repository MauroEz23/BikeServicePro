@model BikeServicePro.ViewModels.Reparaciones.ReparacionDetailViewModel

@{
    ViewData["Title"] = "Detalle de Reparación";
}

<div class="row">
    <div class="col-md-10 mx-auto">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-tools"></i> Detalle de Reparación - @Model.Numero</span>
                <div>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm">
                        <i class="bi bi-pencil"></i>
                    </a>
                    <a asp-action="Index" class="btn btn-secondary btn-sm">
                        <i class="bi bi-arrow-left"></i>
                    </a>
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <h6 class="text-muted">Información General</h6>
                        <dl class="row">
                            <dt class="col-sm-4">Número</dt>
                            <dd class="col-sm-8"><strong>@Model.Numero</strong></dd>
                            
                            <dt class="col-sm-4">Cliente</dt>
                            <dd class="col-sm-8">@Model.ClienteNombre</dd>
                            
                            <dt class="col-sm-4">Bicicleta</dt>
                            <dd class="col-sm-8">@Model.BicicletaNombre</dd>
                            
                            <dt class="col-sm-4">Mecánico</dt>
                            <dd class="col-sm-8">@Model.MecanicoNombre</dd>
                            
                            <dt class="col-sm-4">Fecha de Ingreso</dt>
                            <dd class="col-sm-8">@Model.FechaIngreso.ToString("dd/MM/yyyy HH:mm")</dd>
                            
                            @if (Model.FechaEntrega.HasValue)
                            {
                                <dt class="col-sm-4">Fecha de Entrega</dt>
                                <dd class="col-sm-8">@Model.FechaEntrega.Value.ToString("dd/MM/yyyy HH:mm")</dd>
                            }
                        </dl>
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-muted">Estado y Prioridad</h6>
                        <dl class="row">
                            <dt class="col-sm-5">Estado</dt>
                            <dd class="col-sm-7">
                                <span class="badge bg-@Model.Estado.ToString()" style="font-size: 1rem;">
                                    @Model.Estado
                                </span>
                            </dd>
                            
                            <dt class="col-sm-5">Prioridad</dt>
                            <dd class="col-sm-7">
                                <span class="badge bg-@Model.Prioridad.ToString()">
                                    @Model.Prioridad
                                </span>
                            </dd>
                            
                            <dt class="col-sm-5">Días en Taller</dt>
                            <dd class="col-sm-7">@Model.DiasEnTaller días</dd>
                            
                            @if (Model.EstaAtrasada)
                            {
                                <dt class="col-sm-5">Estado</dt>
                                <dd class="col-sm-7 text-danger">
                                    <i class="bi bi-exclamation-triangle"></i> Atrasada
                                </dd>
                            }
                            
                            <dt class="col-sm-5">Garantía</dt>
                            <dd class="col-sm-7">@(Model.EsGarantia ? "Sí" : "No")</dd>
                        </dl>
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col-md-6">
                        <h6 class="text-muted">Diagnóstico</h6>
                        <p>@Model.Diagnostico</p>
                        
                        @if (!string.IsNullOrEmpty(Model.Observaciones))
                        {
                            <h6 class="text-muted">Observaciones</h6>
                            <p>@Model.Observaciones</p>
                        }
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-muted">Costos</h6>
                        <dl class="row">
                            <dt class="col-sm-6">Mano de Obra</dt>
                            <dd class="col-sm-6">@Model.CostoManoObra.ToString("C")</dd>
                            
                            <dt class="col-sm-6">Repuestos</dt>
                            <dd class="col-sm-6">@Model.CostoRepuestos.ToString("C")</dd>
                            
                            <dt class="col-sm-6">Costo Total</dt>
                            <dd class="col-sm-6"><strong class="text-success">@Model.CostoTotal.ToString("C")</strong></dd>
                        </dl>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.NotasInternas))
                {
                    <div class="mt-3">
                        <h6 class="text-muted">Notas Internas</h6>
                        <div class="alert alert-secondary">
                            @Model.NotasInternas
                        </div>
                    </div>
                }

                <div class="mt-3">
                    <h6 class="text-muted">Última Actualización</h6>
                    <p>@Model.FechaActualizacion.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
            </div>
        </div>
    </div>
</div>