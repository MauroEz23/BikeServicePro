@model IEnumerable<BikeServicePro.ViewModels.Reparaciones.ReparacionListViewModel>

@{
    ViewData["Title"] = "Reparaciones";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nueva Reparación
        </a>
    </div>
    <div>
        <form asp-action="Index" method="get" class="d-flex">
            <select name="estado" class="form-select me-2">
                <option value="">Todos los estados</option>
                @foreach (var estado in ViewBag.Estados as List<BikeServicePro.Models.EstadoReparacion> ?? new List<BikeServicePro.Models.EstadoReparacion>())
                {
                    <option value="@((int)estado)" selected="@(ViewData["Estado"]?.ToString() == ((int)estado).ToString())">
                        @estado
                    </option>
                }
            </select>
            <button type="submit" class="btn btn-outline-secondary">
                <i class="bi bi-funnel"></i> Filtrar
            </button>
        </form>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>N°</th>
                <th>Cliente</th>
                <th>Bicicleta</th>
                <th>Ingreso</th>
                <th>Estado</th>
                <th>Prioridad</th>
                <th>Total</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                @foreach (var reparacion in Model)
                {
                    <tr>
                        <td><strong>@reparacion.Numero</strong></td>
                        <td>@reparacion.ClienteNombre</td>
                        <td>@reparacion.BicicletaNombre</td>
                        <td>@reparacion.FechaIngreso.ToString("dd/MM/yyyy")</td>
                        <td>
                            <span class="badge bg-@reparacion.EstadoColor">
                                @reparacion.EstadoNombre
                            </span>
                        </td>
                        <td>
                            <span class="badge bg-@reparacion.PrioridadColor">
                                @reparacion.PrioridadNombre
                            </span>
                        </td>
                        <td>@reparacion.CostoTotal.ToString("C")</td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Details" asp-route-id="@reparacion.Id" class="btn btn-info">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@reparacion.Id" class="btn btn-warning">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@reparacion.Id" method="post" style="display:inline;" onsubmit="return confirm('¿Estás seguro de eliminar esta reparación?');">
                                    <button type="submit" class="btn btn-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">
                        <i class="bi bi-inbox fs-3 d-block"></i>
                        No hay reparaciones registradas
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>