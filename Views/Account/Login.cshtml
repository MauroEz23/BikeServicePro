@model BikeServicePro.ViewModels.Auth.LoginViewModel

@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BikeService Pro</title>
    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/dark-theme.css" />
    <style>
        body {
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #0d1117;
        }
        .login-container {
            max-width: 420px;
            width: 100%;
            padding: 2rem;
            background: #161b22;
            border-radius: 16px;
            border: 1px solid #30363d;
            box-shadow: 0 8px 32px rgba(0,0,0,0.5);
        }
        .login-logo {
            text-align: center;
            margin-bottom: 2rem;
        }
        .login-logo i {
            font-size: 4rem;
            color: #f0f6fc;
        }
        .login-logo h1 {
            color: #f0f6fc;
            font-weight: 700;
            margin-top: 0.5rem;
        }
        .login-logo small {
            color: #8b949e;
        }
        .form-control {
            background: #0d1117;
            border: 1px solid #30363d;
            color: #f0f6fc;
        }
        .form-control:focus {
            background: #0d1117;
            border-color: #58a6ff;
            box-shadow: 0 0 0 3px rgba(88,166,255,0.3);
            color: #f0f6fc;
        }
        .btn-primary {
            background: #238636;
            border: none;
            padding: 0.75rem;
            font-weight: 600;
        }
        .btn-primary:hover {
            background: #2ea043;
        }
        .form-label {
            color: #f0f6fc;
            font-weight: 500;
        }
        .text-muted-custom {
            color: #8b949e;
        }
        .validation-summary-errors {
            color: #f85149;
        }
        .text-danger {
            color: #f85149 !important;
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="login-logo">
            <i class="bi bi-bicycle"></i>
            <h1>BikeService Pro</h1>
            <small>Sistema de Gestión para Talleres</small>
        </div>

        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

            <div class="mb-3">
                <label asp-for="Username" class="form-label">Nombre de usuario</label>
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary">
                        <i class="bi bi-person text-muted"></i>
                    </span>
                    <input asp-for="Username" class="form-control" placeholder="Ingresa tu usuario" />
                </div>
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Contraseña</label>
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary">
                        <i class="bi bi-lock text-muted"></i>
                    </span>
                    <input asp-for="Password" class="form-control" placeholder="Ingresa tu contraseña" type="password" />
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label text-muted-custom">Recordarme</label>
            </div>

            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-box-arrow-in-right"></i> Iniciar Sesión
            </button>

            <div class="mt-3 text-center text-muted-custom small">
                <p>Credenciales de prueba:</p>
                <p class="mb-0">admin / admin123</p>
                <p class="mb-0">recepcionista / recep123</p>
                <p>mecanico1 / meca123</p>
            </div>
        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
</body>
</html>