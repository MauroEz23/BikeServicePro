@model BikeServicePro.ViewModels.Bicicletas.BicicletaCreateViewModel

@{
    ViewData["Title"] = "Nueva Bicicleta";
}

<div class="row">
    <div class="col-md-8 mx-auto">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-bicycle"></i> Registrar Nueva Bicicleta
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="ClienteId" class="form-label"></label>
                        <select asp-for="ClienteId" class="form-select">
                            <option value="">Seleccione un cliente...</option>
                            @if (ViewBag.Clientes != null)
                            {
                                foreach (var cliente in ViewBag.Clientes as IEnumerable<BikeServicePro.ViewModels.Clientes.ClienteListViewModel>)
                                {
                                    <option value="@cliente.Id">@cliente.NombreCompleto</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="ClienteId" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Marca" class="form-label"></label>
                            <input asp-for="Marca" class="form-control" />
                            <span asp-validation-for="Marca" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Modelo" class="form-label"></label>
                            <input asp-for="Modelo" class="form-control" />
                            <span asp-validation-for="Modelo" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="Anio" class="form-label"></label>
                            <input asp-for="Anio" class="form-control" type="number" />
                            <span asp-validation-for="Anio" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Color" class="form-label"></label>
                            <input asp-for="Color" class="form-control" />
                            <span asp-validation-for="Color" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Talla" class="form-label"></label>
                            <input asp-for="Talla" class="form-control" placeholder="Ej: M, L, XL" />
                            <span asp-validation-for="Talla" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="NumeroSerie" class="form-label"></label>
                            <input asp-for="NumeroSerie" class="form-control" />
                            <span asp-validation-for="NumeroSerie" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Material" class="form-label"></label>
                            <input asp-for="Material" class="form-control" placeholder="Ej: Aluminio, Carbono" />
                            <span asp-validation-for="Material" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="Peso" class="form-label"></label>
                            <input asp-for="Peso" class="form-control" type="number" step="0.1" placeholder="kg" />
                            <span asp-validation-for="Peso" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Grupo" class="form-label"></label>
                            <input asp-for="Grupo" class="form-control" placeholder="Ej: Shimano 105" />
                            <span asp-validation-for="Grupo" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="TipoFrenos" class="form-label"></label>
                            <input asp-for="TipoFrenos" class="form-control" placeholder="Ej: Disco, V-Brake" />
                            <span asp-validation-for="TipoFrenos" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="FotoUrl" class="form-label"></label>
                        <input asp-for="FotoUrl" class="form-control" placeholder="URL de la imagen" />
                        <span asp-validation-for="FotoUrl" class="text-danger"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="Activo" class="form-check-input" />
                        <label asp-for="Activo" class="form-check-label"></label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save"></i> Guardar
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Volver
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}