@model BikeServicePro.ViewModels.Bicicletas.BicicletaDetailViewModel

@{
    ViewData["Title"] = "Detalle de Bicicleta";
}

<div class="row">
    <div class="col-md-8 mx-auto">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-bicycle"></i> Detalle de la Bicicleta</span>
                <div>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm">
                        <i class="bi bi-pencil"></i>
                    </a>
                    <a asp-action="Index" class="btn btn-secondary btn-sm">
                        <i class="bi bi-arrow-left"></i>
                    </a>
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <h6 class="text-muted">Información de la Bicicleta</h6>
                        <dl class="row">
                            <dt class="col-sm-4">Marca</dt>
                            <dd class="col-sm-8">@Model.Marca</dd>
                            
                            <dt class="col-sm-4">Modelo</dt>
                            <dd class="col-sm-8">@Model.Modelo</dd>
                            
                            <dt class="col-sm-4">Año</dt>
                            <dd class="col-sm-8">@Model.Anio</dd>
                            
                            <dt class="col-sm-4">Color</dt>
                            <dd class="col-sm-8">@Model.Color</dd>
                            
                            <dt class="col-sm-4">Material</dt>
                            <dd class="col-sm-8">@Model.Material</dd>
                            
                            <dt class="col-sm-4">Peso</dt>
                            <dd class="col-sm-8">@Model.Peso kg</dd>
                            
                            <dt class="col-sm-4">Talla</dt>
                            <dd class="col-sm-8">@Model.Talla</dd>
                        </dl>
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-muted">Especificaciones Técnicas</h6>
                        <dl class="row">
                            <dt class="col-sm-4">Número de Serie</dt>
                            <dd class="col-sm-8"><code>@Model.NumeroSerie</code></dd>
                            
                            <dt class="col-sm-4">Grupo</dt>
                            <dd class="col-sm-8">@Model.Grupo</dd>
                            
                            <dt class="col-sm-4">Tipo de Frenos</dt>
                            <dd class="col-sm-8">@Model.TipoFrenos</dd>
                            
                            <dt class="col-sm-4">Cliente</dt>
                            <dd class="col-sm-8">@Model.ClienteNombre</dd>
                            
                            <dt class="col-sm-4">Estado</dt>
                            <dd class="col-sm-8">
                                <span class="badge @(Model.Activo ? "bg-success" : "bg-danger")">
                                    @(Model.Activo ? "Activa" : "Inactiva")
                                </span>
                            </dd>
                            
                            <dt class="col-sm-4">Registro</dt>
                            <dd class="col-sm-8">@Model.FechaRegistro.ToString("dd/MM/yyyy")</dd>
                        </dl>
                    </div>
                </div>

                @if (Model.TotalReparaciones > 0)
                {
                    <div class="mt-3">
                        <h6 class="text-muted">Historial de Reparaciones</h6>
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i>
                            Esta bicicleta tiene <strong>@Model.TotalReparaciones</strong> reparaciones registradas.
                            <br />
                            <small>Total gastado: @Model.TotalGastado.ToString("C")</small>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-info mt-3">
                        <i class="bi bi-info-circle"></i> Esta bicicleta no tiene reparaciones registradas.
                    </div>
                }
            </div>
        </div>
    </div>
</div>