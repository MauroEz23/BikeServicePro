@model BikeServicePro.ViewModels.Servicios.ServicioCreateViewModel

@{
    ViewData["Title"] = "Editar Servicio";
}

<div class="row">
    <div class="col-md-8 mx-auto">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-pencil-square"></i> Editar Servicio
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label"></label>
                        <input asp-for="Nombre" class="form-control" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descripcion" class="form-label"></label>
                        <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="PrecioBase" class="form-label"></label>
                            <input asp-for="PrecioBase" class="form-control" type="number" step="0.01" />
                            <span asp-validation-for="PrecioBase" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="TiempoEstimado" class="form-label"></label>
                            <input asp-for="TiempoEstimado" class="form-control" type="number" placeholder="Minutos" />
                            <span asp-validation-for="TiempoEstimado" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Categoria" class="form-label"></label>
                            <select asp-for="Categoria" class="form-select" asp-items="Html.GetEnumSelectList<BikeServicePro.Models.CategoriaServicio>()">
                                <option value="">Seleccione una categoría...</option>
                            </select>
                            <span asp-validation-for="Categoria" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Icono" class="form-label"></label>
                            <input asp-for="Icono" class="form-control" placeholder="Ej: bi-gear" />
                            <span asp-validation-for="Icono" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="RequiereRepuesto" class="form-label"></label>
                        <input asp-for="RequiereRepuesto" class="form-control" placeholder="Tipo de repuesto necesario" />
                        <span asp-validation-for="RequiereRepuesto" class="text-danger"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="Activo" class="form-check-input" />
                        <label asp-for="Activo" class="form-check-label"></label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save"></i> Guardar
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Volver
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}