@model BikeServicePro.ViewModels.Dashboard.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="row">
    <div class="col-12">
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i>
            Bienvenido <strong>@Context.Session.GetString("NombreCompleto")</strong> al sistema de gestión de talleres.
            @Model.Resumen
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-3">
        <div class="card bg-primary bg-opacity-10 border-primary">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title text-muted">Clientes</h6>
                        <h2 class="mb-0" style="color: #f0f6fc !important;">@Model.TotalClientes</h2>
                    </div>
                    <i class="bi bi-people fs-1 text-primary"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-success bg-opacity-10 border-success">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title text-muted">Bicicletas</h6>
                        <h2 class="mb-0" style="color: #f0f6fc !important;">@Model.TotalBicicletas</h2>
                    </div>
                    <i class="bi bi-bicycle fs-1 text-success"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-warning bg-opacity-10 border-warning">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title text-muted">Reparaciones Activas</h6>
                        <h2 class="mb-0" style="color: #f0f6fc !important;">@Model.ReparacionesActivas</h2>
                    </div>
                    <i class="bi bi-tools fs-1 text-warning"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-danger bg-opacity-10 border-danger">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title text-muted">Stock Bajo</h6>
                        <h2 class="mb-0" style="color: #f0f6fc !important;">@Model.ItemsStockBajo</h2>
                    </div>
                    <i class="bi bi-exclamation-triangle fs-1 text-danger"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-graph-up"></i> Reparaciones por Mes
            </div>
            <div class="card-body">
                <canvas id="reparacionesChart" height="250"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-pie-chart"></i> Estado de Reparaciones
            </div>
            <div class="card-body">
                <canvas id="estadoChart" height="250"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-coin"></i> Ingresos Totales
            </div>
            <div class="card-body">
                <h2 style="color: #3fb950 !important;">@Model.IngresosTotales.ToString("C")</h2>
                <p style="color: #8b949e !important;">Promedio por reparación: @Model.PromedioCostoReparacion.ToString("C")</p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-person-gear"></i> Mecánicos
            </div>
            <div class="card-body">
                <h2 style="color: #f0f6fc !important;">@Model.TotalMecanicos</h2>
                <p style="color: #8b949e !important;">Mecánicos activos en el taller</p>
                @if (Model.ReparacionesPorMecanico.Any())
                {
                    <small style="color: #8b949e !important;">Reparaciones por mecánico:</small>
                    <ul class="list-unstyled" style="color: #f0f6fc !important;">
                        @foreach (var item in Model.ReparacionesPorMecanico)
                        {
                            <li style="color: #f0f6fc !important; margin-bottom: 5px;">
                                <span class="badge bg-primary" style="background-color: #1f6feb !important; color: #ffffff !important;">@item.Value</span> 
                                <span style="color: #f0f6fc !important;">@item.Key</span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p style="color: #8b949e !important;">No hay reparaciones asignadas a mecánicos.</p>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Datos de reparaciones por mes
        const meses = @Html.Raw(Json.Serialize(Model.ReparacionesPorMes.Keys));
        const valores = @Html.Raw(Json.Serialize(Model.ReparacionesPorMes.Values));

        // Gráfico de reparaciones por mes
        const ctx1 = document.getElementById('reparacionesChart').getContext('2d');
        new Chart(ctx1, {
            type: 'bar',
            data: {
                labels: meses,
                datasets: [{
                    label: 'Reparaciones',
                    data: valores,
                    backgroundColor: 'rgba(88, 166, 255, 0.7)',
                    borderColor: 'rgba(88, 166, 255, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            color: '#f0f6fc'
                        }
                    },
                    x: {
                        ticks: {
                            color: '#f0f6fc'
                        }
                    }
                }
            }
        });

        // Datos de estado de reparaciones
        const estados = @Html.Raw(Json.Serialize(Model.ReparacionesPorEstado.Keys));
        const cantidades = @Html.Raw(Json.Serialize(Model.ReparacionesPorEstado.Values));
        const colores = ['#ffc107', '#0dcaf0', '#dc3545', '#0d6efd', '#198754', '#6c757d', '#212529'];

        // Gráfico de estado de reparaciones
        const ctx2 = document.getElementById('estadoChart').getContext('2d');
        new Chart(ctx2, {
            type: 'doughnut',
            data: {
                labels: estados,
                datasets: [{
                    data: cantidades,
                    backgroundColor: colores
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            color: '#f0f6fc',
                            font: { size: 10 }
                        }
                    }
                }
            }
        });
    </script>
}