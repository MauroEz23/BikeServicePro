@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="row">
    <div class="col-md-8 mx-auto text-center">
        <div class="card border-danger">
            <div class="card-body p-5">
                <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 4rem;"></i>
                <h1 class="mt-3">Error</h1>
                <p class="text-muted">Lo sentimos, ha ocurrido un error en el sistema.</p>
                
                @if (Model?.ShowRequestId ?? false)
                {
                    <p class="text-muted">
                        <strong>ID de solicitud:</strong> <code>@Model.RequestId</code>
                    </p>
                }
                
                <a asp-action="Index" class="btn btn-primary mt-3">
                    <i class="bi bi-house"></i> Volver al inicio
                </a>
            </div>
        </div>
    </div>
</div>