@model IEnumerable<BikeServicePro.ViewModels.Mecanicos.MecanicoListViewModel>

@{
    ViewData["Title"] = "Mecánicos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nuevo Mecánico
        </a>
        <a asp-action="Index" asp-route-soloActivos="true" class="btn btn-success">
            <i class="bi bi-person-check"></i> Solo Activos
        </a>
    </div>
</div>

<div class="row">
    @if (Model.Any())
    {
        @foreach (var mecanico in Model)
        {
            <div class="col-md-4 mb-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h5 class="card-title">
                                    <i class="bi bi-person-gear"></i> @mecanico.NombreCompleto
                                </h5>
                                <h6 class="card-subtitle text-muted">@mecanico.Especialidad</h6>
                            </div>
                            <span class="badge @mecanico.StatusColor">
                                @mecanico.StatusText
                            </span>
                        </div>
                        <div class="mt-3">
                            <p class="card-text">
                                <i class="bi bi-envelope"></i> @mecanico.Email<br />
                                <i class="bi bi-telephone"></i> @mecanico.Telefono<br />
                                <i class="bi bi-calendar"></i> @mecanico.AñosExperiencia años de experiencia
                            </p>
                        </div>
                        <div class="d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@mecanico.Id" class="btn btn-info btn-sm">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@mecanico.Id" class="btn btn-warning btn-sm">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@mecanico.Id" method="post" style="display:inline;" onsubmit="return confirm('¿Estás seguro de eliminar este mecánico?');">
                                <button type="submit" class="btn btn-danger btn-sm">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="text-center text-muted py-5">
                <i class="bi bi-inbox fs-1 d-block"></i>
                <p>No hay mecánicos registrados</p>
            </div>
        </div>
    }
</div>